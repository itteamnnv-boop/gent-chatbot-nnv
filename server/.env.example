# ---- Server ----
PORT=4000
NODE_ENV=development
# Origin của React app (dev: Vite)
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Đặt "memory" để chạy MongoDB in-memory (chỉ dùng khi dev, dữ liệu mất khi tắt server)
MONGODB_URI=mongodb://127.0.0.1:27017/sales_agent

# ---- OpenAI (luồng xử lý chính) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ---- Admin dashboard ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay
JWT_SECRET=chuoi-bi-mat-dai-va-ngau-nhien

# ---- Meta (Messenger / Instagram / WhatsApp Cloud API) ----
# Token tự đặt, nhập giống hệt trong Meta App > Webhooks
META_VERIFY_TOKEN=my-verify-token
# App Secret dùng để xác thực chữ ký X-Hub-Signature-256
META_APP_SECRET=
# App ID của Meta App (dùng cho nút "Kết nối Facebook" trong trang quản trị)
META_APP_ID=
# URL callback OAuth, phải khai báo y hệt trong Facebook Login > Valid OAuth Redirect URIs
# vd: https://<domain>/api/meta/oauth/callback  (dev: http://localhost:5173/api/meta/oauth/callback)
META_OAUTH_REDIRECT_URI=
# Page Access Token (Messenger + Instagram)
META_PAGE_ACCESS_TOKEN=
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
